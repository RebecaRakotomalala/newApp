@model List<newApp.Models.Fournisseur>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau des données</title>
    <link rel="stylesheet" href="~/css/style2.css"> 
    <link rel="stylesheet" href="~/css/liste.css">
    <link rel="stylesheet" href="~/css/styleTab.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Dans le head -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">

    <!-- Avant la fermeture du body -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="app-container">
        <!-- Inclure la sidebar -->
        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">
            <h2>Supplier</h2>

            @if (ViewBag.Erreur != null)
            {
                <div class="alert alert-danger">@ViewBag.Erreur</div>
            }
            else if (Model != null && Model.Count > 0)
            {
                <form method="get" action="/Fournisseur/Index" class="select-form">
                    <div class="custom-select-container">
                        <select name="id" class="custom-select" required>
                            <option value="">-- Sélectionnez un fournisseur --</option>
                            @foreach (var f in Model)
                            {
                                <option value="@f.name">@f.name</option>
                            }
                        </select>
                        <div class="select-arrow">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <button type="submit" class="select-button">
                        <i class="fas fa-search"></i> Recherchée
                    </button>
                </form>
            }
            else
            {
                <p>Aucun fournisseur trouvé.</p>
            }

            <!-- Affichage des devis si un fournisseur est sélectionné -->
            @if (ViewBag.Devis != null && ((List<newApp.Models.AppelOffre>)ViewBag.Devis).Count > 0)
            {
                <h3>Request for Quotation : @ViewBag.Fournisseur</h3>
                
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>NumeroDevis</th>
                            <th>Fournisseur</th>
                            @* <th>Date Transaction</th>
                            <th>Date Livraison Prévue</th> *@
                            <th>Statut</th>
                            <th>Message</th>
                            <th>Devis</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var devis in (List<newApp.Models.AppelOffre>)ViewBag.Devis)
                        {
                            <tr>
                                <td>@devis.NumeroDevis</td>
                                <td>@devis.Supplier</td>
                                @* <td>@devis.DateTransaction.ToString("dd-MM-yyyy")</td>
                                <td>@devis.DateLivraisonPrevue.ToString("dd-MM-yyyy")</td> *@
                                <td>@devis.Status</td>
                                <td>@devis.Message</td>
                                <td class="actions">
                                    <form method="get" action="/Fournisseur/DevisFournisseur" class="inline-form">
                                        <input type="hidden" name="rfqName" value="@devis.NumeroDevis">
                                        <input type="hidden" name="fournisseur" value="@devis.Supplier">
                                        <button type="submit" class="btn-view" title="Consulter le devis">
                                            <i class="fas fa-file-contract"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                <div class="export-buttons">
                                    <!-- Bouton CSV -->
                                    @* <form method="post" action="/Fournisseur/csvFromErpNext" class="d-inline">
                                        <input type="hidden" name="devisName" value="@devis.NumeroDevis" />
                                        <button type="submit" class="btn btn-link p-0 export-csv-btn" title="Exporter en CSV">
                                            <i class="fas fa-file-csv fa-xs"></i>
                                        </button>
                                    </form> *@
                                    
                                    <!-- Bouton PDF -->
                                    <form method="post" action="/Fournisseur/ExportFromErpNext" class="d-inline">
                                        <input type="hidden" name="devisName" value="@devis.NumeroDevis" />
                                        <button type="submit" class="btn btn-link p-0 export-pdf-btn" title="Exporter depuis ERPNext">
                                            <i class="fas fa-file-pdf text-danger fa-xs"></i>
                                        </button>
                                    </form>
                                </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            @if (ViewBag.BonCommande != null && ((List<newApp.Models.BonCommande>)ViewBag.BonCommande).Count > 0)
            {
                <h3>Purchase Order : @ViewBag.Fournisseur</h3>

                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Commande</th>
                                <th>Fournisseur</th>
                                <th>Article</th>
                                <th>Quantité</th>
                                <th>Prix Unitaire</th>
                                <th>Montant</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bon in (List<newApp.Models.BonCommande>)ViewBag.BonCommande)
                            {
                                <tr>
                                    <td>@bon.PurchaseOrder</td>
                                    <td>@bon.Supplier</td>
                                    <td>@bon.ItemCode</td>
                                    <td>@bon.Quantity</td>
                                    <td>@bon.Rate</td>
                                    <td>@bon.Amount</td>
                                    @if (bon.Status == "To Receive and Bill"){
                                        <td style="color: #ff9800;">@bon.Status</td>
                                    } else if ((bon.Status == "To Receive")) {
                                        <td style="color: #d6b004;">@bon.Status</td>  
                                    } else if ((bon.Status == "Draft")) {
                                        <td style="color: #2911ff;">@bon.Status</td>  
                                    } else {
                                        <td>@bon.Status</td> 
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</body>
</html>