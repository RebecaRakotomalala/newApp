@{
    ViewData["Title"] = "Sidebar";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ma Page avec Sidebar</title>
    <link rel="stylesheet" href="~/css/style2.css" />
    <!-- Font Awesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h2>Mon Application</h2>
            </div>
            
            <nav class="sidebar-nav">
                <ul>
                    <li class="active">
                        <a href="#">
                            <i class="fas fa-home"></i>
                            <span>Accueil</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="fas fa-chart-line"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="fas fa-user"></i>
                            <span>Profil</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="fas fa-cog"></i>
                            <span>Paramètres</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Déconnexion</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <div class="sidebar-footer">
                <div class="user-info">
                    <div class="user-details">
                        <span class="user-name">Rebeca</span>
                        <span class="user-role">Administrateur</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Contenu principal -->
        <div class="main-content">
            <div class="content-header">
                <h1>Bienvenue sur votre tableau de bord</h1>
            </div>
            
            <div class="content-body">
                <div class="card">
                    <h3>Vos statistiques</h3>
                    <p>Voici quelques informations importantes...</p>
                </div>
                
                <div class="card-grid">
                    <div class="card">
                        <h4><i class="fas fa-users"></i> Utilisateurs</h4>
                        <p>150 inscrits</p>
                    </div>
                    <div class="card">
                        <h4><i class="fas fa-shopping-cart"></i> Commandes</h4>
                        <p>42 cette semaine</p>
                    </div>
                    <div class="card">
                        <h4><i class="fas fa-chart-pie"></i> Performance</h4>
                        <p>+12% ce mois</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>