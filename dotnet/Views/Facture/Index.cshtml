@model List<newApp.Models.Facture>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau des données</title>
    <link rel="stylesheet" href="~/css/style2.css"> 
    <link rel="stylesheet" href="~/css/liste.css">
    <link rel="stylesheet" href="~/css/styleTab.css">
    <link rel="stylesheet" href="~/css/modal.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Dans le head -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">

    <!-- Avant la fermeture du body -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="app-container">
        <!-- Inclure la sidebar -->
        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">
            <h2>Liste des Factures</h2>
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Fournisseur</th>
                        <th>Montant Total TTC</th>
                        <th>Reste à payer</th>
                        <th>Montant déjà payé</th>
                        <th>Details</th>
                        <th>Action</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var facture in Model)
                    {
                        <tr>
                            <td>@facture.Name</td>
                            <td>@facture.Supplier</td>
                            <td>@(facture.GrandTotal.ToString("N2"))</td>
                            <td>@(facture.OutstandingAmount.ToString("N2"))</td>
                            <td>@( (facture.GrandTotal - @facture.OutstandingAmount).ToString("N2")) </td>
                            <td>
                                <button type="button" class="btn btn-sm" data-toggle="modal" data-target="#modalDetails-@facture.Name">
                                    <i class="fas fa-list-alt text-info"></i>
                                </button>
                            </td>
                            <td class="text-center">
                                <form method="post" action="/Facture/ExportFromErpNext" class="d-inline">
                                    <input type="hidden" name="factureName" value="@facture.Name" />
                                    <button type="submit" class="btn btn-link p-0 export-pdf-btn" title="Exporter depuis ERPNext">
                                        <i class="fas fa-file-pdf text-danger fa-xs"></i>
                                    </button>
                                </form>
                            </td>
                            <td>
                                @if (facture.Status == "Unpaid" || facture.Status == "Partly Paid" || facture.Status == "Overdue")
                                {
                                    <div class="d-flex align-items-center">
                                        @* <span class="badge badge-pill status-unpaid">@facture.Status</span> *@
                                        <form method="post" action="/Facture/Paiement" class="compact-form">
                                            <input type="hidden" name="id" value="@facture.Name">
                                            <input type="hidden" name="supplier" value="@facture.Supplier">
                                            <div class="input-group" style="width: auto;">
                                                <input type="number" 
                                                    name="rate" 
                                                    value="@facture.OutstandingAmount" 
                                                    class="form-control rate-input"
                                                    min="0"
                                                    step="0.01"
                                                    title="Modifier le taux">
                                                <button type="submit" class="btn-save" title="Enregistrer les modifications">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge badge-pill status-paid">@facture.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Modals pour chaque facture -->
        @foreach (var facture in Model)
        {
            <div class="modal fade modal-facture" id="modalDetails-@facture.Name" tabindex="-1" role="dialog" aria-labelledby="modalDetailsLabel-@facture.Name" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalDetailsLabel-@facture.Name">Détails de la facture: @facture.Name</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong>Date de création:</strong> @facture.PostingDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="col-md-4">
                                    <strong>Date d'échéance:</strong> @facture.DueDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="col-md-4">
                                    <strong>Statut:</strong> @facture.Status
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <strong>Fournisseur:</strong> @facture.Supplier
                                </div>
                            </div>
                            
                            <h6>Articles</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Code article</th>
                                            <th>Nom article</th>
                                            <th>Quantité</th>
                                            <th>Prix unitaire</th>
                                            <th>Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (facture.Items != null && facture.Items.Any())
                                        {
                                            foreach (var item in facture.Items)
                                            {
                                                <tr>
                                                    <td>@item.ItemCode</td>
                                                    <td>@item.ItemName</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@item.Rate</td>
                                                    <td>@item.Amount</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5">Aucun article.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>