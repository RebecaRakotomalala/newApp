@model List<newApp.Models.Facture>
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Calendrier des Factures";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau des données</title>
    <link rel="stylesheet" href="~/css/style2.css"> 
    <link rel="stylesheet" href="~/css/liste.css">
    <link rel="stylesheet" href="~/css/styleTab.css">
    <link rel="stylesheet" href="~/css/modal.css">

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/fr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        #calendar {
            max-width: 1100px;
            margin: 40px auto;
            font-family: 'Segoe UI', sans-serif;
        }
        .fc-event { cursor: pointer; border-radius: 4px; }
        .fc-event-unpaid { background-color: #ff6b6b; border: none; }
        .fc-event-paid { background-color: #51cf66; border: none; }
        .fc-event-partly-paid { background-color: #fcc419; border: none; }
    </style>
</head>
<body>
    <div class="app-container">
            <!-- Inclure la sidebar -->
            @await Html.PartialAsync("_Sidebar")

            <div class="main-content">
                <div class="container">
                    <h2 class="text-center">@ViewData["Title"]</h2>
                    <div id="calendar"></div>
                </div>
            </div>      
    </div>
</body>
</html>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var factures = @Html.Raw(JsonConvert.SerializeObject(Model.Select(f => new {
            title = f.Name + " - " + f.Supplier + " (" + f.GrandTotal + " €)",
            start = f.PostingDate.ToString("yyyy-MM-dd"),
            end = f.DueDate.ToString("yyyy-MM-dd"),
            status = f.Status,
            extendedProps = new {
                supplier = f.Supplier,
                amount = f.GrandTotal,
                paid = (f.GrandTotal - f.OutstandingAmount),
                outstanding = f.OutstandingAmount,
                status = f.Status,
                endStr = f.DueDate.ToString("yyyy-MM-dd")
            }
        })));

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            events: factures.map(function (f) {
                return {
                    title: f.title,
                    start: f.start,
                    end: f.end,
                    className: 'fc-event-' + f.status.toLowerCase().replace(' ', '-'),
                    extendedProps: f.extendedProps
                };
            }),
            eventClick: function (info) {
                var e = info.event;
                var content = `
                    <strong>Fournisseur:</strong> ${e.extendedProps.supplier}<br/>
                    <strong>Total:</strong> ${e.extendedProps.amount} €<br/>
                    <strong>Déja Payé:</strong> ${e.extendedProps.paid} €<br/>
                    <strong>Reste Payé:</strong> ${e.extendedProps.outstanding} €<br/>
                    <strong>Statut:</strong> ${e.extendedProps.status}<br/>
                    <strong>Date d'échéance:</strong> ${e.extendedProps.endStr}<br/>
                `;
                Swal.fire({
                    title: e.title,
                    html: content,
                    confirmButtonText: 'Fermer',
                    confirmButtonColor: '#3085d6'
                });
            }
        });

        calendar.render();
    });
</script>
